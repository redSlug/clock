# Copy this OUTSIDE the repo, for example to ~/.config/circular-led/setup.env, then:
#   chmod 600 ~/.config/circular-led/setup.env
#   npm run setup:cloudflare -- --env-file ~/.config/circular-led/setup.env
# Every line is optional. Anything left out is prompted for.
CLOUDFLARE_API_TOKEN=
WORKERS_SUBDOMAIN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=
RC_CLIENT_ID=
RC_CLIENT_SECRET=
BETTER_AUTH_SECRET=
